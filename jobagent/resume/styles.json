{
  "version": 1,
  "_about": "Resume style conventions as DATA. Edit freely; the tailoring code reads these profiles and contains no country- or company-specific rules. Conventions are widely published guidance (recruiter/ATS norms), not copied from any individual's resume.",

  "default_company_type": "big_tech",
  "default_role_family": "dotnet_backend",

  "company_types": {
    "big_tech": {
      "label": "Big tech / MNC",
      "bullet_max_chars": 200,
      "max_bullets_per_role": 5,
      "max_bullets_per_project": 3,
      "max_side_projects": 2,
      "max_bullets_per_side_project": 2,
      "emphasise_projects": true,
      "skills_max_groups": 5,
      "skills_max_items": 8,
      "summary_sentences": 3,
      "summary_max_chars": 430,
      "metric_weight": 1.0,
      "section_order": ["summary", "experience", "projects", "skills", "education", "achievements"],
      "headings": {"projects": "Projects"},
      "verbs": ["Built", "Delivered", "Reduced", "Improved", "Shipped", "Designed", "Automated", "Engineered", "Launched", "Scaled", "Optimised", "Migrated", "Integrated", "Led"],
      "emphasis_patterns": ["\\d+\\s?%", "\\d+\\+?\\s+(?:users|hours|languages|modules|services)", "\\bperformance\\b", "\\bscal\\w+", "\\blatency\\b", "\\breal[- ]time\\b"],
      "tone": "Impact-first, metric-led bullets in the XYZ pattern: 'Accomplished [X] as measured by [Y] by doing [Z]'. When the original bullet contains a metric, lead with the result and keep the exact number. When it has no metric, lead with the concrete thing built and its scope; never invent a metric. Concise (one to two lines), plain international English, no buzzwords or hype adjectives."
    },
    "enterprise": {
      "label": "Enterprise / established company",
      "bullet_max_chars": 220,
      "max_bullets_per_role": 6,
      "max_bullets_per_project": 4,
      "max_side_projects": 2,
      "max_bullets_per_side_project": 2,
      "emphasise_projects": false,
      "skills_max_groups": 6,
      "skills_max_items": 10,
      "summary_sentences": 3,
      "summary_max_chars": 480,
      "metric_weight": 0.6,
      "section_order": ["summary", "skills", "experience", "projects", "education", "achievements"],
      "headings": {"projects": "Projects"},
      "verbs": ["Delivered", "Implemented", "Migrated", "Integrated", "Standardised", "Maintained", "Improved", "Designed", "Automated", "Secured", "Documented", "Collaborated", "Supported", "Developed"],
      "emphasis_patterns": ["\\brbac\\b", "\\baccess control\\b", "\\bcomplian\\w+", "\\bmigrat\\w+", "\\benterprise\\b", "\\bworkflow\\w*", "\\bschema\\b", "\\breport\\w*", "\\bscal\\w+", "\\bstakeholder\\w*", "\\bbusiness analysts?\\b"],
      "tone": "Emphasise stability, scale, domain understanding, process and governance: access control, compliance, data integrity, migrations, maintainability, documentation and cross-team collaboration. Measured, formal tone; quantify scale where the original gives a number."
    },
    "startup": {
      "label": "Startup / scale-up",
      "bullet_max_chars": 200,
      "max_bullets_per_role": 5,
      "max_bullets_per_project": 3,
      "max_side_projects": 3,
      "max_bullets_per_side_project": 3,
      "emphasise_projects": true,
      "skills_max_groups": 5,
      "skills_max_items": 8,
      "summary_sentences": 2,
      "summary_max_chars": 380,
      "metric_weight": 0.7,
      "section_order": ["summary", "experience", "projects", "skills", "education", "achievements"],
      "headings": {"projects": "Projects"},
      "verbs": ["Built", "Shipped", "Launched", "Owned", "Created", "Automated", "Delivered", "Designed", "Prototyped", "Integrated", "Drove", "Scaled"],
      "emphasis_patterns": ["\\bindependently\\b", "\\bend[- ]to[- ]end\\b", "\\bfrom scratch\\b", "\\bfull[- ]stack\\b", "\\bautomat\\w+", "\\bshipped\\b", "\\blaunch\\w*", "\\bstandalone\\b"],
      "tone": "Emphasise ownership, speed and end-to-end delivery: what was built, shipped and owned across the stack, and how quickly. Direct, energetic but strictly factual; short bullets."
    }
  },

  "company_detection": {
    "_about": "Auto mode only. Known employers win; otherwise text signals are counted with weights. Nothing detected -> default_company_type.",
    "known_employers": {
      "big_tech": ["stripe", "datadog", "cloudflare", "gitlab", "mongodb", "elastic", "airbnb", "coinbase", "okta", "twilio", "figma", "asana", "databricks", "snowflake", "spotify", "palantir", "microsoft", "google", "alphabet", "amazon", "aws", "meta", "facebook", "apple", "netflix", "booking", "bookingcom", "adyen", "n26", "wise", "monzo", "deliveroo", "xero", "atlassian", "shopify", "intercom", "dropbox", "squarespace", "toast", "celonis", "zalando", "uber", "linkedin", "salesforce", "oracle", "ibm", "sap", "nvidia", "intel", "adobe", "paypal", "ebay", "workday", "servicenow", "hubspot", "canva", "rakuten", "mercari", "careem", "notion", "miro", "1password", "elevenlabs", "synthesia", "cohere", "openai", "anthropic"],
      "enterprise": ["accenture", "deloitte", "pwc", "kpmg", "ey", "capgemini", "infosys", "tcs", "tata consultancy services", "wipro", "hcl", "cognizant", "siemens", "bosch", "allianz", "axa", "hsbc", "barclays", "lloyds", "jpmorgan", "jp morgan", "goldman sachs", "morgan stanley", "citi", "citigroup", "deutsche bank", "ing", "abn amro", "bnp paribas", "santander", "ericsson", "nokia", "vodafone", "bt", "unilever", "philips", "shell", "bp", "emirates", "etisalat", "fujitsu", "nec", "hitachi", "telstra", "commonwealth bank", "rbc", "td bank"],
      "startup": []
    },
    "signals": {
      "big_tech": [
        {"pattern": "fortune\\s*(?:500|100)", "weight": 2},
        {"pattern": "\\b\\d{1,3}(?:,\\d{3})+\\+?\\s+employees", "weight": 2},
        {"pattern": "\\b\\d{2,3}k\\+?\\s+employees", "weight": 2},
        {"pattern": "offices in (?:over |more than )?\\d+\\s+countries", "weight": 2},
        {"pattern": "\\b(?:millions|billions) of (?:users|customers|requests|transactions)", "weight": 2},
        {"pattern": "\\b(?:nyse|nasdaq|publicly traded|listed company)\\b", "weight": 1.5},
        {"pattern": "\\bglobal (?:leader|company|scale|presence|team)\\b", "weight": 1},
        {"pattern": "\\bglobal\\b", "weight": 0.5},
        {"pattern": "\\bat scale\\b|\\bhyper-?scale\\b", "weight": 1}
      ],
      "enterprise": [
        {"pattern": "\\b(?:bank|banking|insurance|insurer|financial services|asset management)\\b", "weight": 1.5},
        {"pattern": "\\b(?:regulated|regulatory|compliance|sox|iso 27001|pci[- ]dss|gdpr)\\b", "weight": 1},
        {"pattern": "\\b(?:public sector|government|ministry|healthcare|pharma\\w*|telecom\\w*)\\b", "weight": 1.5},
        {"pattern": "\\b(?:consultancy|consulting firm|system integrator|itil|erp|sap)\\b", "weight": 1},
        {"pattern": "\\b(?:established in|founded in) (?:1[89]\\d\\d)\\b", "weight": 1.5},
        {"pattern": "\\bfortune\\s*500\\b", "weight": 0.5}
      ],
      "startup": [
        {"pattern": "\\bpre-?seed\\b|\\bseed[- ](?:stage|round|funded)\\b|\\bseed\\b", "weight": 2},
        {"pattern": "\\bseries [a-c]\\b", "weight": 2},
        {"pattern": "\\bearly[- ]stage\\b", "weight": 2},
        {"pattern": "\\bfounding (?:engineer|team|member)\\b", "weight": 2.5},
        {"pattern": "\\by ?combinator\\b|\\byc[- ]backed\\b|\\bventure[- ]backed\\b|\\bvc[- ]backed\\b", "weight": 1.5},
        {"pattern": "\\bstart-?up\\b|\\bscale-?up\\b", "weight": 1},
        {"pattern": "\\bfirst \\d+ engineers\\b|\\bsmall team\\b|\\bwear many hats\\b", "weight": 1},
        {"pattern": "\\bequity\\b|\\bstock options\\b", "weight": 0.5}
      ]
    }
  },

