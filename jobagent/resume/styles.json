  "countries": {
    "default": {
      "spelling": "uk",
      "date_format": "mon_yyyy",
      "page_size": "A4",
      "doc_title": "CV",
      "header": {"nationality": false, "work_authorization": true, "relocation": true, "availability": true},
      "headings": {},
      "never_include": ["photo", "date_of_birth", "marital_status", "religion", "full_address"],
      "notes": "Generic international English CV: one column, no photo, no date of birth, no marital status."
    },
    "_europe": {
      "inherits": "default",
      "header": {"nationality": true},
      "headings": {"summary": "Profile", "experience": "Work Experience"},
      "notes": "European employers commonly expect nationality and work-permit status for non-EU applicants. Photos and dates of birth appear on some local CVs but are deliberately omitted (anti-discrimination law, ATS parsing)."
    },
    "GB": {"inherits": "_europe", "doc_title": "CV", "notes": "UK CV: right-to-work / visa status stated plainly; no photo or date of birth (Equality Act norms)."},
    "IE": {"inherits": "_europe", "doc_title": "CV", "notes": "Irish CV: Critical Skills / General Employment Permit context - state sponsorship need plainly; no photo or date of birth."},
    "DE": {"inherits": "_europe", "date_format": "mm_yyyy", "notes": "English-language CV for English postings. German Lebenslauf conventions (photo, birth date, signature) are not applied; German-language postings expect a German CV."},
    "AT": {"inherits": "_europe", "date_format": "mm_yyyy", "notes": "As Germany: English CV; photo/birth date omitted."},
    "CH": {"inherits": "_europe", "date_format": "mm_yyyy", "notes": "Swiss employers value permit status; non-EU hiring is quota-limited - state sponsorship need plainly."},
    "NL": {"inherits": "_europe", "notes": "Highly-skilled-migrant (kennismigrant) route requires a recognised sponsor; state sponsorship need."},
    "SE": {"inherits": "_europe", "notes": "Swedish CVs are concise and factual; English is widely accepted in tech."},
    "DK": {"inherits": "_europe", "notes": "Danish CVs favour brevity and concrete results."},
    "FI": {"inherits": "_europe", "notes": "Finnish CVs are concise; English common in tech."},
    "BE": {"inherits": "_europe", "notes": "Belgium: English CV acceptable in tech; language skills often matter."},
    "LU": {"inherits": "_europe", "notes": "Luxembourg: multilingual market; English CV acceptable in tech."},
    "FR": {"inherits": "_europe", "notes": "France: English CV for international roles; French CV expected for French postings."},
    "ES": {"inherits": "_europe", "notes": "Spain: English CV for international roles."},
    "PT": {"inherits": "_europe", "notes": "Portugal: English CV common in tech hubs (Lisbon, Porto)."},
    "IT": {"inherits": "_europe", "notes": "Italy: English CV for international roles; GDPR consent line not added (not needed for ATS submissions)."},
    "PL": {"inherits": "_europe", "notes": "Poland: English CV common in tech; GDPR consent clause sometimes requested by the employer."},
    "CZ": {"inherits": "_europe", "notes": "Czechia: English CV common in tech."},
    "EE": {"inherits": "_europe", "notes": "Estonia: English is the default working language in tech."},
    "NO": {"inherits": "_europe"},
    "LT": {"inherits": "_europe"},
    "LV": {"inherits": "_europe"},
    "RO": {"inherits": "_europe"},
    "GR": {"inherits": "_europe"},
    "HU": {"inherits": "_europe"},
    "MT": {"inherits": "_europe"},
    "CY": {"inherits": "_europe"},
    "US": {
      "inherits": "default", "spelling": "us", "page_size": "Letter", "doc_title": "Resume",
      "header": {"nationality": false},
      "headings": {"summary": "Summary", "experience": "Professional Experience"},
      "notes": "US resume: Letter size, US spelling, one page under ~10 years' experience; never photo, age, nationality or marital status. Work-authorization/sponsorship line kept because it is an application screening question."
    },
    "CA": {
      "inherits": "default", "spelling": "us", "page_size": "Letter", "doc_title": "Resume",
      "header": {"nationality": false},
      "headings": {"summary": "Summary", "experience": "Professional Experience"},
      "notes": "Canadian resume: Letter size; no photo/age/nationality (human-rights norms). -ize spelling is standard in Canadian English."
    },
    "AU": {
      "inherits": "default", "doc_title": "Resume",
      "header": {"nationality": false},
      "headings": {"summary": "Professional Summary", "experience": "Work Experience"},
      "notes": "Australian resume: A4, UK spelling; state work rights (visa sponsorship) clearly; no photo or date of birth."
    },
    "AE": {
      "inherits": "default", "doc_title": "CV",
      "header": {"nationality": true},
      "headings": {"summary": "Profile", "experience": "Work Experience"},
      "notes": "UAE CV: nationality and visa status are customary. Local CVs often show photo and date of birth; omitted here for ATS and privacy."
    },
    "JP": {
      "inherits": "default", "spelling": "us", "doc_title": "CV",
      "header": {"nationality": true},
      "headings": {"summary": "Summary", "experience": "Work Experience"},
      "notes": "English-language CV for international employers in Japan. Japanese rirekisho / shokumu-keirekisho formats are not generated; nationality and visa need are customary."
    },
    "SG": {
      "inherits": "default", "doc_title": "Resume",
      "header": {"nationality": true},
      "headings": {"summary": "Summary", "experience": "Work Experience"},
      "notes": "Singapore: Employment Pass context; nationality customary."
    },
    "IN": {
      "inherits": "default", "doc_title": "Resume",
      "header": {"nationality": false, "work_authorization": false},
      "headings": {"summary": "Professional Summary", "experience": "Professional Experience"},
      "notes": "India: citizen, no work-authorization line needed."
    }
  },

