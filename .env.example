# Copy to .env (git-ignored) and fill in. Placeholders only - never commit real values.

# REQUIRED: random 32+ character secret used to sign short-lived cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBAGENT_SECRET_KEY=replace-with-a-long-random-secret

# Resume file (read-only; never modified). PDF, DOCX or TXT.
JOBAGENT_RESUME_PATH=C:\path\to\your\resume.pdf

# Database. Local default is SQLite in ./data/jobagent.db.
# For Vercel/hosted use PostgreSQL (e.g. Neon): DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# JOBAGENT_DB_PATH=C:\path\to\jobagent.db
# DATABASE_URL=

# AI provider (optional): none | openai | anthropic. Everything works without AI.
JOBAGENT_AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hosted deployments only:
# CRON_SECRET protects /api/cron/run (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# One-time token required to create the first account on a non-localhost deployment.
JOBAGENT_SETUP_TOKEN=

# ---------------------------------------------------------------- multi-user sign-up & email
# Address that receives "new sign-up" approval requests (with signed Approve / Reject links).
JOBAGENT_ADMIN_EMAIL=admin@example.com
# Public base URL used in emailed links (must be https except localhost). On Vercel it defaults to the project's
# production URL; set it explicitly if you use a custom domain.
JOBAGENT_PUBLIC_URL=https://your-app.example.com
# Email provider (pick one; with none configured, emails are only recorded in the Admin page outbox):
#  a) Resend HTTP API  (https://resend.com -> API Keys). The default sender works only to your own Resend
#     account address until you verify a domain; then set JOBAGENT_MAIL_FROM to an address on that domain.
RESEND_API_KEY=
JOBAGENT_MAIL_FROM=JobAgent <onboarding@resend.dev>
#  b) SMTP, e.g. Gmail with an App Password (Google account -> Security -> App passwords). Port 587 = STARTTLS,
#     465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local server (defaults shown). Remote binding is refused unless JOBAGENT_ALLOW_REMOTE=1 and HTTPS is configured.
# JOBAGENT_HOST=127.0.0.1
# JOBAGENT_PORT=8765
# JOBAGENT_ALLOW_REMOTE=0
# JOBAGENT_HTTPS=0
# JOBAGENT_SESSION_IDLE_MINUTES=30
# JOBAGENT_SESSION_ABSOLUTE_HOURS=8
